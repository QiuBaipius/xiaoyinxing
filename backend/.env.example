# ===== 智谱 GLM 大模型配置 =====
# 在 https://open.bigmodel.cn 申请 API Key
GLM_API_KEY=你的智谱APIKey
GLM_MODEL=glm-4.7-flash
# 模型降级链：主模型限流时按顺序自动切换
GLM_MODELS=glm-4.7-flash,glm-4-flash
# 图片理解模型
GLM_VISION_MODEL=glm-4.6v-flash
EMBEDDING_MODEL=embedding-3
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 知识库 / 采集 =====
DATA_DIR=./data
# 自动采集间隔（小时，作为 fallback）
CRAWL_INTERVAL_HOURS=6
# 上班时段定时采集（24 小时制，逗号分隔，如 9、15 点各一次）
COLLECT_HOURS=9,15
# 是否启动时自动开启定时采集
AUTO_CRAWL=1

# ===== 召回策略 =====
# 向量 + BM25 混合召回，最终返回条数
TOP_K=5
# 候选池大小
CANDIDATE_K=10
# 是否启用 LLM 相关性精排（边界判定，只保留真正相关的资料）
ENABLE_RERANK=1

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
