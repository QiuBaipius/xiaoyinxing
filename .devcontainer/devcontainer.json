{
  "name": "小银杏 Xiaoyinxing (Python)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "小银杏 Web/API", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "remoteEnv": {
    "GLM_API_KEY": "${localEnv:GLM_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
